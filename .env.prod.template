# Production environment template
# Copy to .env.prod and fill in values. .env.prod is gitignored.
# Used by: DEPLOY_ENV=prod ./deploy.sh

# --- MySQL ---
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=

# --- Auth & external APIs ---
JWT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
YOUTUBE_API_KEY=
GEMINI_API_KEY=
TYPESAFE_API_KEY=
# GITHUB_VOC_TOKEN: fine-grained PAT (Issues: Read and write on eastshine2741/japanese-vocabulary).
# 앱 '개발자 괴롭히기' 제출이 type:voc 이슈로 올라간다. 비우면 제출 API 가 503 을 돌려준다.
GITHUB_VOC_TOKEN=

# --- Apple Music API (곡 검색·아티스트 별칭 확인·노래방 신곡 매칭) ---
# developer.apple.com → Keys 에서 Media Services(MusicKit) 키를 만들 때 받은 값. .p8 은 한 번만 내려받을 수 있다.
# TEAM_ID 는 Membership details, PRIVATE_KEY_BASE64 는 base64 -w0 AuthKey_<KEY_ID>.p8
# 비우면 앱은 뜨지만 첫 카탈로그 호출이 실패한다.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY_BASE64=

# --- Object storage (Cloudflare R2, 프로필 사진) ---
# 버킷은 infra/terraform 이 만든다. 키는 Cloudflare 대시보드 R2 → Manage API tokens 에서
# kotonoha-prod 버킷 하나에 Object Read & Write 로 발급한다. 하나라도 비면 업로드 API 가 503.
# ENDPOINT: https://<account-id>.r2.cloudflarestorage.com
# PUBLIC_BASE_URL: 버킷에 붙인 커스텀 도메인 (https://img.kotonoha.eastshine.dev)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=kotonoha-prod
OBJECT_STORAGE_PUBLIC_BASE_URL=https://img.kotonoha.eastshine.dev

# --- Admin (admin-api / admin-web) ---
# ADMIN_PASSWORD_SHA256: 어드민 로그인 비밀번호의 sha256 (소문자 hex 64자). prod 는 평문을 받지 않는다.
#   printf '%s' 'your-password' | sha256sum
# ADMIN_TOKEN_SECRET: 어드민 토큰 서명 키. 최소 32자. 공개 JWT_SECRET 과 반드시 다른 값.
#   openssl rand -hex 32
# 어드민은 https://kotonoha.eastshine.dev/admin 에 공개 노출되고 이 비밀번호 하나로만 막힌다.
ADMIN_PASSWORD_SHA256=
ADMIN_TOKEN_SECRET=

# --- RabbitMQ (곡 분석 작업 큐) ---
# 자격증명은 여기 두지 않는다. Cluster Operator 가 네임스페이스마다 rabbitmq-default-user
# 시크릿을 만들고, api/admin-api/worker 가 그 시크릿을 직접 참조한다.
#   kubectl get secret rabbitmq-default-user -n kotonoha -o jsonpath='{.data.password}' | base64 -d

# --- Observability ---
# Grafana admin password — used by k8s/observability/install.sh (helm --set-string).
# Pick a strong random value; rotate by re-running install.sh.
GRAFANA_ADMIN_PASSWORD=

# --- GitHub Container Registry (ghcr.io) ---
# GHCR_USERNAME: your GitHub login (lowercase), must match PAT owner.
# GHCR_TOKEN: Classic PAT with scopes write:packages, read:packages.
# Image namespace is ghcr.io/${GHCR_USERNAME}/kotonoha-{api,batch,worker,migration,admin-api,admin-web}.
GHCR_USERNAME=
GHCR_TOKEN=

# --- Sentry (backend) ---
# Per-project DSN from sentry.io. Leave blank to disable Sentry.
SENTRY_DSN_API=
SENTRY_DSN_BATCH=
# 비우면 deploy.sh 가 SENTRY_DSN_BATCH 를 그대로 쓴다. 곡 분석 결손 로그를 읽는
# .github/scripts/analysis-feedback 러너가 batch 프로젝트를 보고 있어서, 분리하려면 그 문서도 같이 고칠 것.
SENTRY_DSN_WORKER=

# --- Firebase (push notifications) ---
# Base64 of the service account JSON. Generate with:
#   base64 -w0 firebase-service-account.json    (Linux)
#   base64 -i firebase-service-account.json     (macOS)
# Decoded contents mount at /var/secrets/firebase/service-account.json in the worker, batch cron,
# and admin-api pods. Required to send FCM; those pods fail to start without it when
# PUSH_FIREBASE_ENABLED=true.
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

APPLE_OAUTH_CLIENT_ID=
