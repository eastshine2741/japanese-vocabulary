# Copy to .github/scripts/daily-digest/.env (gitignored) and fill in. Loaded by the systemd unit via
# EnvironmentFile. kubectl(kotonoha-prod), bq, gh use the logged-in local credentials.

# Discord webhook of the digest channel. Not the Alertmanager one: alerts and the digest go to
# separate channels so a quiet digest does not hide behind alert noise.
DISCORD_DIGEST_WEBHOOK_URL=
# 1 when the webhook belongs to a forum channel (one post per day, title = date).
DISCORD_DIGEST_FORUM=1

# Sentry: read-only token with event:read on the org. Same token as analysis-feedback works.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=eastshine

# Optional. Defaults shown.
#DAILY_DIGEST_EXPECTED_RUNNERS="analysis-feedback:3 issue-resolver:2"
#DAILY_DIGEST_REVIEWER_DROP=0.3
#DAILY_DIGEST_MIN_ACTIVE=10
#DAILY_DIGEST_FUNNEL_MIN_BASE=10
#DAILY_DIGEST_FUNNEL_DROP_PP=15
#DAILY_DIGEST_RANK_MODEL=sonnet
#DAILY_DIGEST_MAX_BUDGET_USD=1
#DAILY_DIGEST_STATE_DIR=$HOME/.local/state/kotonoha-daily-digest
