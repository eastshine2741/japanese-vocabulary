# Copy to .github/scripts/analysis-feedback/.env (gitignored) and fill in. Loaded by the systemd
# unit via EnvironmentFile.

# Sentry: read-only token with event:read on the org. The runner never writes to Sentry.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=eastshine
# Numeric project id of kotonoha-batch-prod (the organization events API takes ids, not slugs).
SENTRY_PROJECT=4511478144172032

# Optional. Defaults shown.
#ANALYSIS_FEEDBACK_WINDOW=6h
#ANALYSIS_FEEDBACK_MAX_CANDIDATES=20
#ANALYSIS_FEEDBACK_PROVIDER_ERROR_ALERT=10
#ANALYSIS_FEEDBACK_MAX_FIX_ATTEMPTS=2
#ANALYSIS_FEEDBACK_TEST_TIMEOUT=15m
#ANALYSIS_FEEDBACK_CLASSIFY_MODEL=sonnet
#ANALYSIS_FEEDBACK_FIX_MODEL=opus
#ANALYSIS_FEEDBACK_MAX_BUDGET_USD=5
#ANALYSIS_FEEDBACK_STATE_DIR=$HOME/.local/state/kotonoha-analysis-feedback
