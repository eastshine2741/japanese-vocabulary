{
  "title": "Analysis defect fix result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "reason",
    "commitTitle",
    "why",
    "how",
    "gradleTask",
    "testClass"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "implemented",
        "gave_up"
      ]
    },
    "reason": {
      "type": "string"
    },
    "commitTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 72
    },
    "why": {
      "type": "string",
      "minLength": 1
    },
    "how": {
      "type": "string",
      "minLength": 1
    },
    "gradleTask": {
      "type": "string",
      "pattern": "^:[a-z-]+(:[a-z-]+)*:test$"
    },
    "testClass": {
      "type": "string",
      "minLength": 1
    }
  }
}
