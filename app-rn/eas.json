{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "BUILD_ENV": "dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "BUILD_ENV": "staging"
      }
    },
    "simulator": {
      "distribution": "internal",
      "environment": "production",
      "ios": {
        "simulator": true
      },
      "env": {
        "BUILD_ENV": "prod"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "BUILD_ENV": "prod"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6806729387"
      }
    }
  }
}
