default_platform(:ios)

platform :ios do
  # EAS Submit 이 TestFlight 까지 올린 빌드를 심사에 낸다. 출시 버튼은 심사 통과 뒤 사람이 누른다.
  lane :submit_review do |options|
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
    )

    # 키워드·부제는 새 버전 제출 때만 바뀌므로 스토어 정보도 이 심사 제출에 같이 싣는다.
    # build_number 를 주면 처리 대기 없이 바로 찾다가 실패한다 — app_version 의 최신 빌드를 기다리게 둔다.
    deliver(
      api_key: api_key,
      app_identifier: "dev.eastshine.kotonoha",
      app_version: options.fetch(:version),
      skip_binary_upload: true,
      skip_screenshots: true,
      metadata_path: File.expand_path("metadata/ios", __dir__),
      release_notes: { "ko" => options.fetch(:release_notes) },
      submit_for_review: true,
      automatic_release: false,
      submission_information: { add_id_info_uses_idfa: false },
      run_precheck_before_submit: false,
      force: true,
    )
  end
end

platform :android do
  # Play 스토어 등록정보는 빌드와 무관하게 바로 바뀐다. 텍스트만 올리고 이미지·출시 노트는 건드리지 않는다.
  lane :upload_listing do
    upload_to_play_store(
      package_name: "dev.eastshine.kotonoha",
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      metadata_path: File.expand_path("metadata/android", __dir__),
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
