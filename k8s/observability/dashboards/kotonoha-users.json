          "editorMode": "code",
          "rawQuery": true,
          "format": 0,
          "rawSql": "SELECT\n  TIMESTAMP(PARSE_DATE('%Y%m%d', event_date), 'Asia/Seoul') AS time,\n  COUNT(DISTINCT IF(event_name = 'session_start', user_pseudo_id, NULL)) AS dau,\n  COUNT(DISTINCT IF(event_name = 'card_rate', user_pseudo_id, NULL)) AS learners,\n  COUNTIF(event_name = 'card_rate' AND (SELECT COALESCE(value.int_value, CAST(value.double_value AS INT64)) FROM UNNEST(event_params) WHERE key = 'rating') = 1) AS r1,\n  COUNTIF(event_name = 'card_rate' AND (SELECT COALESCE(value.int_value, CAST(value.double_value AS INT64)) FROM UNNEST(event_params) WHERE key = 'rating') = 2) AS r2,\n  COUNTIF(event_name = 'card_rate' AND (SELECT COALESCE(value.int_value, CAST(value.double_value AS INT64)) FROM UNNEST(event_params) WHERE key = 'rating') = 3) AS r3,\n  COUNTIF(event_name = 'card_rate' AND (SELECT COALESCE(value.int_value, CAST(value.double_value AS INT64)) FROM UNNEST(event_params) WHERE key = 'rating') = 4) AS r4\nFROM `japanese-vocabulary-490916.analytics_539684755.events_*`\nWHERE (_TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', DATE($__timeFrom(), 'Asia/Seoul')) AND FORMAT_DATE('%Y%m%d', DATE($__timeTo(), 'Asia/Seoul'))\n    OR _TABLE_SUFFIX BETWEEN CONCAT('intraday_', FORMAT_DATE('%Y%m%d', DATE($__timeFrom(), 'Asia/Seoul'))) AND CONCAT('intraday_', FORMAT_DATE('%Y%m%d', DATE($__timeTo(), 'Asia/Seoul'))))\n  AND _TABLE_SUFFIX NOT IN (\n    SELECT CONCAT('intraday_', SUBSTR(table_id, 8))\n    FROM `japanese-vocabulary-490916.analytics_539684755.__TABLES__`\n    WHERE table_id BETWEEN CONCAT('events_', FORMAT_DATE('%Y%m%d', DATE($__timeFrom(), 'Asia/Seoul'))) AND CONCAT('events_', FORMAT_DATE('%Y%m%d', DATE($__timeTo(), 'Asia/Seoul'))))\n  AND event_date BETWEEN FORMAT_DATE('%Y%m%d', DATE($__timeFrom(), 'Asia/Seoul')) AND FORMAT_DATE('%Y%m%d', DATE($__timeTo(), 'Asia/Seoul'))\n  AND app_info.id = 'dev.eastshine.kotonoha'\n  AND COALESCE(user_id, '') <> '1'\n  AND event_name IN ('session_start', 'card_rate')\nGROUP BY time\nORDER BY time"
        }
