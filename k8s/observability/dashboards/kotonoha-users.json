          "editorMode": "code",
          "rawQuery": true,
          "format": 0,
          "rawSql": "SELECT\n  TIMESTAMP(PARSE_DATE('%Y%m%d', event_date), 'Asia/Seoul') AS time,\n  COUNTIF(event_name = 'first_open' AND platform = 'ANDROID') AS android,\n  COUNTIF(event_name = 'first_open' AND platform = 'IOS') AS ios,\n  COUNTIF(event_name = 'app_remove' AND platform = 'ANDROID') AS android_removes\nFROM `japanese-vocabulary-490916.analytics_539684755.events_*`\nWHERE (_TABLE_SUFFIX BETWEEN FORMAT_DATE('%Y%m%d', DATE($__timeFrom(), 'Asia/Seoul')) AND FORMAT_DATE('%Y%m%d', DATE($__timeTo(), 'Asia/Seoul'))\n    OR _TABLE_SUFFIX BETWEEN CONCAT('intraday_', FORMAT_DATE('%Y%m%d', DATE($__timeFrom(), 'Asia/Seoul'))) AND CONCAT('intraday_', FORMAT_DATE('%Y%m%d', DATE($__timeTo(), 'Asia/Seoul'))))\n  AND _TABLE_SUFFIX NOT IN (\n    SELECT CONCAT('intraday_', SUBSTR(table_id, 8))\n    FROM `japanese-vocabulary-490916.analytics_539684755.__TABLES__`\n    WHERE table_id BETWEEN CONCAT('events_', FORMAT_DATE('%Y%m%d', DATE($__timeFrom(), 'Asia/Seoul'))) AND CONCAT('events_', FORMAT_DATE('%Y%m%d', DATE($__timeTo(), 'Asia/Seoul'))))\n  AND event_date BETWEEN FORMAT_DATE('%Y%m%d', DATE($__timeFrom(), 'Asia/Seoul')) AND FORMAT_DATE('%Y%m%d', DATE($__timeTo(), 'Asia/Seoul'))\n  AND app_info.id = 'dev.eastshine.kotonoha'\n  AND COALESCE(user_id, '') <> '1'\n  AND event_name IN ('first_open', 'app_remove')\nGROUP BY time\nORDER BY time"
